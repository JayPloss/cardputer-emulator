# HOME's pages: the arrows walk through them, the ends bump, settings open and come back to HOME.
wait-text "HOME" 60000
wait-text "SUPACHAT" 3000
shot page1.png
press left
shot bump-left.png
expect-text "SUPACHAT"
wait 400
press right
wait 300
press right
wait-text "TIMER" 3000
expect-text "STOPWATCH"
expect-text "CLOCK"
expect-no-clipping
shot page2.png
press left
wait-text "SUPACHAT" 3000
press right
wait-text "TIMER" 3000
press right
wait 300
press right
wait-text "WI-FI" 3000
expect-text "LANGUAGE"
expect-no-clipping
shot page3.png
# Volume, on the same page.
press right
wait 300
press enter
wait-text "VOLUME" 3000
expect-text "OK BACK"
press enter
wait-text "WI-FI" 3000
# Status, and the rear button comes back to HOME.
press left
wait 300
press down
wait 300
press enter
wait-text "LEFT/RIGHT PAGE" 3000
press right
wait-text "NODE" 3000
button
wait-text "LANGUAGE" 3000
# On to page 4 from the right column of page 3.
press right
wait 300
press right
wait-text "CHARGING" 3000
expect-text "LOCAL OFF"
expect-text "CHANGELOG"
expect-text "SYSTEM"
expect-no-clipping
shot page4.png
# Page 5: SCREEN and AGENDA (v0.66), BRIGHT and PLACES (v0.68). Right from page 4 lands on it; its right edge bumps.
press right
wait 300
press right
wait-text "PLACES" 3000
expect-text "AGENDA"
expect-text "BRIGHT"
expect-no-text "SYSTEM"
expect-no-clipping
shot page5.png
press right
wait 300
press right
wait 300
press right
shot bump-right.png
expect-text "PLACES"
expect-text "AGENDA"
wait 400
press up
wait 400
expect-text "AGENDA"
press left
wait 300
# Back to page 4 on the top row (LOCAL OFF); the changelog is bottom left.
# Its first entry is this build. Back with the top-left key.
press left
wait-text "CHANGELOG" 3000
press down
wait 300
press left
wait 300
press enter
wait-text "v0.68" 3000
press esc
wait-text "CHANGELOG" 3000
press 4
wait-text "FREE" 3000
press enter
wait-text "CHANGELOG" 3000
report pages walked
expect-no-clipping
