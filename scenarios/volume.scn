# v0.67's three volumes on the VOLUME screen, each its own NVS key: ALARM (LOW to MAX), SYSTEM (MUTE
# to MAX) and MEDIA (mute and 20 steps). A ring starts at the alarm volume and climbs to full; a book
# plays at the media volume, which Up and Down step in the player.
wait-text "HOME" 60000
press right
wait 300
press right
wait-text "TIMER" 3000
press right
wait 300
press right
wait-text "WI-FI" 3000
press right
wait 300
press enter
wait-text "MEDIA" 3000
# A fresh device starts from the old setting's default, HIGH: 15 of 20, the alarm HIGH too.
expect-text "15/20"
expect-text "SYSTEM"
expect-text "ALARM"
expect-text "UP/DOWN CHOOSE  LEFT/RIGHT CHANGE"
expect-nvs "vol_media	15"
expect-nvs "vol_alarm	3"
shot volume.png
expect-no-clipping
# MEDIA, the first row chosen: Right is 16 of 20, and its sample sounds at that volume.
press right
wait 300
expect-text "16/20"
expect-nvs "vol_media	16"
expect-volume 0 204 204
press left left left left left left left left left left left left left left left left
wait 500
expect-text "MUTE"
expect-nvs "vol_media	0"
press left
wait 300
expect-text "MUTE"
press right right right right right right right right right right
wait 500
expect-text "10/20"
expect-nvs "vol_media	10"
# SYSTEM: HIGH to LOW; the key tone is at LOW.
press up
wait 300
press left left
wait 500
expect-nvs "vol_system	1"
expect-volume 0 64 64
# ALARM: down to LOW, and no further: a ring can't be silent.
press up
wait 300
press left
wait 300
expect-volume 0 128 128
press left
wait 300
expect-volume 0 64 64
press left
wait 300
expect-nvs "vol_alarm	1"
expect-no-text "MUTE"
press up
wait 300
shot volume-alarm-low.png
expect-no-clipping
press enter
wait-text "WI-FI" 3000
# The timer rings at the alarm volume, LOW, and is at full 30 s later.
press left
wait 300
press left
wait 300
press left
wait-text "TIMER" 3000
press enter
wait-text "READY" 3000
press del
wait-text "TYPE A TIME" 3000
type "5"
wait-text "0:05" 3000
press enter
wait-text "TIME'S UP!" 15000
wait 500
expect-volume 0 64 64
wait 31000
expect-volume 0 255 255
press a
wait-text "TIMER" 3000
press esc
wait-text "HOME" 3000
press left
wait-text "SUPACHAT" 3000
# A book at the media volume, 10 of 20; Up in the player makes it 11.
press 3
wait-text "Stinky" 30000
press down down down down down down
press enter
wait-text "Welcome to Boulderay" 30000
press enter
wait-text "PLAYING" 15000
wait 3000
expect-text "VOL 10"
expect-volume 1 128 128
expect-audio 1
press up
wait 500
expect-text "VOL 11"
expect-volume 1 140 140
expect-nvs "vol_media	11"
shot playing-vol.png
expect-no-clipping
# Key tones beside a book stay well under it: SYSTEM LOW, scaled for listening.
press down
wait 300
expect-text "VOL 10"
expect-volume 0 9 9
