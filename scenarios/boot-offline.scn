# No network in range: the splash gives way at once, and the card still plays.
wifi off
wait-text "HOME" 12000
report at HOME
press 3
wait-text "Stinky" 20000
press down down down down down down
press enter
wait-text "Welcome" 20000
press enter
wait-text "PLAYING" 15000
wait 20000
expect-audio 15
expect-underruns 0
report playing offline
