# No Wi-Fi since turning on: the clock is only the build time, so the alarm says so and never rings.
wifi off
wait-text "HOME" 15000
press right
wait 300
press right
wait 300
press right
wait 300
press enter
wait-text "CLOCK NOT SET" 3000
expect-text "+ NEW ALARM"
clock 2026-11-09 06:59:50
type "0700"
wait-text "CLOCK NOT SET" 3000
expect-no-clipping
shot alarm-noclock.png
wait 75000
expect-no-text "SNOOZE"
expect-text "CLOCK NOT SET"
# CLOCK on HOME says the same instead of showing the build time.
press esc
wait-text "HOME" 3000
press down
wait 300
press left
wait 300
expect-text "CLOCK"
press enter
wait-text "CLOCK NOT SET YET" 3000
expect-text "HOME"
expect-no-clipping
report no clock done
